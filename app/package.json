{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "expo": "^56.0.3",
    "expo-audio": "~56.0.9",
    "expo-constants": "~56.0.14",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.5",
    "expo-sharing": "~56.0.23",
    "expo-speech-recognition": "^3.1.3",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "llama.rn": "^0.12.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "// react-native-gesture-handler": "Pulled in transitively by expo-router (drawer layout), unused here — navigation is a plain Stack. Its codegen output paths exceed the Windows 260-character limit and break the native build, so it is not linked.",
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "private": true
}
