{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "bun --bun jest",
    "test:llm": "bun --bun jest --runInBand --testMatch \"**/regression/llmRegression.run.ts\"",
    "typecheck": "bun check --no-script",
    "check": "bun run typecheck && bun run lint && bun run test",
    "lint": "oxlint src"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/onest": "^0.4.2",
    "expo": "^56.0.3",
    "expo-asset": "56.0.13",
    "expo-audio": "~56.0.9",
    "expo-calendar": "~56.0.10",
    "expo-constants": "~56.0.14",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-modules-core": "56.0.12",
    "expo-router": "~56.2.5",
    "expo-sharing": "~56.0.23",
    "expo-speech-recognition": "56.0.4",
    "expo-splash-screen": "~56.0.16",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "llama.rn": "^0.12.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "oxlint": "1.95.0"
  },
  "overrides": {
    "expo-modules-jsi": "56.0.7"
  },
  "expo": {
    "autolinking": {
      "// react-native-gesture-handler": "Pulled in transitively by expo-router (drawer layout), unused here — navigation uses Stack and JavaScript tabs. Its codegen output paths exceed the Windows 260-character limit and break the native build, so it is not linked.",
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "private": true,
  "patchedDependencies": {
    "llama.rn@0.12.3": "patches/llama.rn@0.12.3.patch",
    "expo-speech-recognition@56.0.4": "patches/expo-speech-recognition@56.0.4.patch"
  },
  "packageManager": "bun@1.4.5"
}
