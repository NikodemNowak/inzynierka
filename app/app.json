{
  "expo": {
    "name": "Notatki",
    "slug": "notatki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "pl": "./locales/pl.json",
      "en": "./locales/en.json"
    },
    "scheme": "notatki",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "10",
      "deploymentTarget": "17.0",
      "supportsTablet": true,
      "bundleIdentifier": "com.nowak.notatki"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.nowak.notatki"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withNotatkiProcessing",
      "./plugins/withLlamaSourceBuild",
      "llama.rn",
      [
        "expo-audio",
        {
          "microphonePermission": "Pozwól aplikacji Notatki na nagrywanie dźwięku.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-status-bar",
      "expo-router",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pozwól aplikacji Notatki na nagrywanie dźwięku.",
          "speechRecognitionPermission": "Pozwól aplikacji Notatki na rozpoznawanie mowy.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Pozwól aplikacji Notatki dodawać zadania do kalendarza.",
          "remindersPermission": "Pozwól aplikacji Notatki dodawać zadania do Przypomnień."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "pl",
            "en"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ]
  }
}
