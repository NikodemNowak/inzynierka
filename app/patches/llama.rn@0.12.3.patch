diff --git a/cpp/jsi/JSIParams.cpp b/cpp/jsi/JSIParams.cpp
index 21bfe1b..b19af3f 100644
--- a/cpp/jsi/JSIParams.cpp
+++ b/cpp/jsi/JSIParams.cpp
@@ -471,7 +471,22 @@ namespace rnllama_jsi {
 
         std::string grammar = getPropertyAsString(runtime, params, "grammar");
         if (!grammar.empty()) {
-            sparams.grammar = {COMMON_GRAMMAR_TYPE_USER, std::move(grammar)};
+            auto grammarType = COMMON_GRAMMAR_TYPE_USER;
+            // Schema-aware chat grammars contain the template's assistant prefix.
+            // Advance those grammars through the prefix already present in the
+            // prompt; explicit user grammars keep their existing no-prefill path.
+            if (getPropertyAsBool(runtime, params, "grammar_from_chat_template", false) &&
+                getPropertyAsInt(runtime, params, "chat_format", 0) != 0 &&
+                params.hasProperty(runtime, "response_format")) {
+                const auto responseFormat = params.getProperty(runtime, "response_format");
+                if (responseFormat.isObject()) {
+                    const auto formatType = getPropertyAsString(runtime, responseFormat.asObject(runtime), "type");
+                    if (formatType == "json_schema" || formatType == "json_object") {
+                        grammarType = COMMON_GRAMMAR_TYPE_OUTPUT_FORMAT;
+                    }
+                }
+            }
+            sparams.grammar = {grammarType, std::move(grammar)};
         }
 
         std::string jsonSchema = getPropertyAsString(runtime, params, "json_schema");
